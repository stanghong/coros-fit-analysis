# Runtime mode
# Use ENV=dev for local development; ENV=prod (or any non-dev value) for production
ENV=dev

# CORS (comma-separated list)
# In production, set this explicitly to your frontend origins
# Example: CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Strava
STRAVA_ENABLED=true
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback
STRAVA_SCOPE=activity:read_all

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/coros_fit?sslmode=require
DB_AUTO_CREATE=false

# Optional
BACKGROUND_SYNC_ENABLED=false
